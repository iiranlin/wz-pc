  "scripts": {
    "dev": "vue-cli-service serve --open",
    "serve": "SET NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service serve --open",
    "build": "vue-cli-service build",
    "build:test": "vue-cli-service build --mode test",
